{
  "lineWidth": 100,
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {
    "cargo.applyConventions": false
  },
  "typescript": {
    "quoteStyle": "preferDouble",
    "semiColons": "always",
    "arrowFunction.useParentheses": "force",
    "trailingCommas": "onlyMultiLine",
    "module.sortImportDeclarations": "maintain"
  },
  "excludes": [
    "canonical-output/",
    "canonical-output-*/",
    "dist/",
    "docs/audits/",
    "docs/measurements/",
    "target/",
    "tests/fixtures/",
    "THIRD_PARTY_NOTICES.md",
    "vendor/",
    "web/",
    // page.rs reads this file line by line, and fills the next one in as text.
    "xtask/pages/page-data.js",
    "xtask/pages/reduced-cost-wrapper.js"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm@5cebd0459bf1aa13fb027331720158d03e2a897b1d9f7b3bf93cac661ca4ddbd",
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm@9c52244de2c25a33addc7ddacff4443234a2dc4b5d3f34131262d1e0df35007c",
    "https://plugins.dprint.dev/toml-0.9.0.wasm@776e088ed4255a51a80e3640e5fd20b15661147e86df3e99611aaa37e9c59852",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae"
  ]
}
