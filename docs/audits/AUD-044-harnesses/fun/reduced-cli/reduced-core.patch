+/// AUD-044 probe only: the full-size settings run at 256 KiB and one pass, so that the command-line
+/// flows can run within the audit's limits. Smaller costs, those of the self-checks, stay.
+fn audit_cost(memory_kib: u32, passes: u32) -> (u32, u32) {
+    if memory_kib >= 1 << 21 { (256, 1) } else { (memory_kib, passes) }
+}
