  "findings": [
    {
      "id": "AUD-036-BLD001",
      "category": "BLD",
      "kind": "finding",
      "title": "Windows external observer does not constrain the DACL threat context",
      "severity": "low",
      "status": "fixed",
      "releaseBlocking": true,
      "affectedFiles": [
        "src/bin/mhfe/protect/windows/tests.rs",
        "src/bin/mhfe/protect/windows/tests/observer.rs"
      ],
      "reproduction": "Run the Windows native process-protection test at c059b1a on the hosted runner.",
      "expected": "Both external observers exercise ordinary same-user access without privileged DACL bypass.",
      "observed": "Strict DACL equality, memory_access and startup passed, but the fresh negative VM_READ open succeeded; 199 CLI cases passed and one failed.",
      "impact": "The test can fail outside the documented DACL threat model. This does not demonstrate ordinary-user access after hardening; baseline effective privileges were not measured.",
      "recommendedFix": "Prepare the same ordinary observer for both controls: reject impersonation/SYSTEM, disable only SeDebugPrivilege and independently read back its disabled/absent state.",
      "implementedFix": "A test-only shared observer helper performs those checks with owned handles and bounded aligned token metadata; every original grant/denial assertion remains.",
      "requiredVerification": "Native Windows compilation and paired ordinary VM_READ/WRITE_DAC grants/denials, plus startup and optimized CLI/pseudo-console acceptance.",
      "evidence": {
        "localOnly": true,
        "log": "commands/native-policy-pushed-ci-windows-red.log",
        "sha256": "edfc6a1fb2268bd23019cb453204f37a573eec3563383c45da2c96c4ff53c38f"
      }
    },
    {
      "id": "AUD-036-BLD002",
      "category": "BLD",
      "kind": "finding",
      "title": "Damaged macOS known-answer fixtures lose hardened-runtime signing",
      "severity": "low",
      "status": "fixed",
      "releaseBlocking": true,
      "affectedFiles": [
        "scripts/terminal_suite/self_test.py"
      ],
      "reproduction": "Run the native PTY suite against the optimized runtime-signed c059b1a CLI.",
      "expected": "Flipping one known-answer bit changes the tested answer while retaining the original runtime-policy conditions.",
      "observed": "damaged_copy re-signed with bare codesign --force --sign -, omitting runtime. Wrong-answer startup/menu refusals passed, then exact full-report comparison failed because the damaged copy reported hardened runtime unverified.",
