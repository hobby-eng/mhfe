  "findings": [
    {
      "id": "AUD-026-BLD003",
      "category": "BLD",
      "kind": "finding",
      "title": "macOS synthetic ptrace signal can be consumed by the Rust tracer",
      "severity": "low",
      "status": "fixed",
      "releaseBlocking": true,
      "relatedFinding": "AUD-026-BLD003 continuation; retain the original identifier",
      "reproduction": "Run the ordinary macOS attachment test at 8ebba34 on the authorized native CI host.",
      "expected": "An attachable control followed by the protected tracer terminating with real SIGSEGV.",
      "observed": "The control succeeded; protected PT_ATTACH returned EBUSY and the tracer panicked exit101. The monitor saw no terminating signal.",
      "impact": "The required native protection test fails; no successful protected attach or private-data exposure is demonstrated.",
      "recommendedFix": "Restore/read back SIG_DFL only in both disposable public tracers, after disabling core files.",
