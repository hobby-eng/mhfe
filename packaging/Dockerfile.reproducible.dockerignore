# Read by BuildKit for packaging/Dockerfile.reproducible, the file of the same name next to
# it. The patterns are relative to the build context, the repository root.
.git
.github
target
release
canonical-output*
dist
*.log
**/__pycache__
*.tmp
# Audit evidence is local and never part of a build.
docs/audits/*-evidence
# The fuzz targets' builds, corpora, findings and coverage.
fuzz/target
fuzz/corpus
fuzz/artifacts
fuzz/coverage
